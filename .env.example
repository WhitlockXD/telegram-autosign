PORT=8000
HOST=0.0.0.0
# 公开监听必填；也兼容变量名 AUTH_TOKEN
TG_AUTH_TOKEN=
# 可选：让 Node 直接提供 HTTPS
# TLS_CERT_FILE=/absolute/path/to/fullchain.pem
# TLS_KEY_FILE=/absolute/path/to/privkey.pem
TG_API_ID=
TG_API_HASH=
TG_SESSION_STRING=
TG_WORKDIR=.signer
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
TZ=Asia/Shanghai
